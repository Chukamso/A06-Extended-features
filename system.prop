persist.sys.use_16bpp_alpha=1
device.internal=1
debug.performance.tuning=1
MultitouchMinDistance=1px
MultitouchSettleInterval=0.1ms
persist.vendor.qti.inputopts.enable=true
persist.vendor.qti.inputopts.movetouchslop=0.1
QuietInterval=0.1ms
SurfaceOrientation=0
TapInterval=0.1ms
TapSlop=1px1
TapDragInterval=0.1ms
touch.coverage.calibration=box
touch.distance.calibration=area
touch.distance.scale=0
touch.gestureMode=spots
touch.orientation.calibration=interpolated
touch.orientationAware=1
touch.pressure.calibration=amplitude
touch.pressure.scale=0.0001
touch.size.bias=0
touch.size.calibration=geometric
touch.size.isSummed=0
touch.size.scale=1
touch.toolSize.areaScale=22
touch.toolSize.isSummed=0
touch.deviceType=touchScreen
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.shared=speed
profiler.launch=false
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1
profiler.debugmonitor=false
profiler.hung.dumpdobugreport=false
video.accelerate.hw=1
windowsmgr.max_events_per_sec=300
ro.surface_flinger.max_frame_buffer_acquired_buffers 3
ro.max.fling_velocity=16000
ro.min.fling_velocity=8000
view.scroll_friction=2
ro.min_pointer_dur=8
ro.com.google.cdb.spa1=bsxasm1
ro.bbt.support.circle2search=true
ro.media.enc.jpeg.quality=100
ro.media.dec.jpeg.memcap=8000000
ro.media.enc.hprof.vid.bps=8000000
ro.media.capture.maxres=8m
ro.camcorder.videoModes=true
ro.media.enc.hprof.vid.fps=65
ro.camera.enableCamera1MaxZsl=1
camera.disable_zsl_mode=1
media.stagefright.enable-meta=true
media.stagefright.enable-scan=true
media.stagefright.enable-http=true
media.stagefright.enable-rtsp=true
media.stagefright.enable-record=false
ro.telephony.call_ring.delay=0
ring.delay=0
ro.sys.fw.bg_apps_limit=8
ro.sys.fw.trim_cache_percent=100
ro.config.nocheckin=1
ro.surface_flinger.protected_contents=true
dalvik.vm.checkjni=false
dalvik.vm.dexopt-data-only=1
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=384m
dalvik.vm.verify-bytecode=false
dalvik.vm.execution-mode=int:jit
dalvik.vm.lockprof.threshold=250
dalvik.vm.dexopt-flags=m=v,o=y
dalvik.vm.stack-trace-file=/data/anr/traces.txt
dalvik.vm.heaptargetutilzation=0.75
dalvik.vm.jmiopts=forcecopy
ro.config.fha_enable=false
ro.config.dha_cached_max=8
ro.config.dha_empty_max=6
ro.config.dha_empty_init=6
